# Shodan API Configuration
SHODAN_API_KEY=your_shodan_api_key_here

# Output Configuration
OUTPUT_DIR=./output
# CLI file paths are confined (src/safe_paths.py): scanner inputs (--ips lists,
# Nostr relay lists, nostr.watch exports) must live under INPUT_DIR, and dumps
# read by db-import / db-import-nostr (or written by --json) under OUTPUT_DIR.
INPUT_DIR=./data

# alt-bitnodes peer source (python -m src.peers.fetch alt-bitnodes) — our own
# bitnodes crawler; builds <INPUT_DIR>/peers/alt-bitnodes.txt for --ips.
ALT_BITNODES_URL=https://pesquisa.hacknodes.xyz
# Union of the snapshots in the last N days (one snapshot every ~40 min)
ALT_BITNODES_WINDOW_DAYS=8
# Seconds between snapshot downloads (be gentle with our own server)
ALT_BITNODES_DELAY=0.2
LOG_LEVEL=INFO

# Scan Configuration
MAX_RESULTS_PER_QUERY=1000
ENABLE_HOST_ENRICHMENT=true
MAX_ENRICHMENTS=100

# Rate Limiting
RATE_LIMIT_DELAY=1
QUERY_COOLDOWN=2

# Report Configuration
GENERATE_CSV=true
GENERATE_JSON=true
GENERATE_CHARTS=true

# Web Interface Configuration
WEB_API_KEY=change-me-to-a-strong-random-secret
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Expose Swagger UI (/docs), ReDoc (/redoc), and /openapi.json. Disabled by default
# to keep the public surface minimal. Set to 1/true/yes in local dev to explore the API.
ENABLE_API_DOCS=0
# Origin of the Next.js dashboard frontend (frontend/). Used for CORS allow-list.
# Comma-separated for multiple origins.
FRONTEND_ORIGIN=http://localhost:3000

# NVD (National Vulnerability Database) Configuration
# Optional: obtain a free API key at https://nvd.nist.gov/developers/request-an-api-key
# Without a key: rate limit is 5 requests/30s (slower initial fetch)
# With a key: rate limit is 50 requests/30s
NVD_API_KEY=
# Cache TTL in hours before re-fetching from NVD (default: 24)
NVD_CACHE_TTL_HOURS=24

# MaxMind GeoIP Configuration
# Download .mmdb files with: scripts/download_geoip_dbs.sh
GEOIP_DB_DIR=./geoip_dbs
MAXMIND_LICENSE_KEY=your_maxmind_license_key_here

# IP reputation enrichment (python -m src.db.cli db-enrich-ips)
# AbuseIPDB: optional; free tier = 1000 checks/day. Each lookup discloses the
# node IP to AbuseIPDB. Leave empty to skip the source.
ABUSEIPDB_API_KEY=
ABUSEIPDB_DAILY_QUOTA=1000
# Minimum seconds between AbuseIPDB requests
ABUSEIPDB_MIN_INTERVAL=1
# Re-enrich an IP once its reputation is older than this many days
REPUTATION_STALE_DAYS=7
# Public blocklists matched locally (no key, no quota, no IP disclosure).
# Comma-separated ids: firehol_level1,spamhaus_drop,feodo,tor_exit (default: all)
# BLOCKLISTS=firehol_level1,spamhaus_drop,feodo,tor_exit
BLOCKLIST_CACHE_DIR=.blocklist_cache
