# Allow the deploy user to manage BOTH bitcoin-scanner systemd units and
# reload nginx without a password, so scripts/deploy.sh can run unattended
# (cron, CI runner, or a plain SSH session).
#
# Installed by scripts/bootstrap-host.sh, which rewrites `ubuntu` to the
# actual deploy user and validates with `visudo -cf`. DO NOT install by hand
# without `visudo -cf` — a syntax error here locks you out of sudo.

ubuntu ALL=(root) NOPASSWD: /bin/systemctl restart bitcoin-scanner, /bin/systemctl restart bitcoin-scanner.service, /bin/systemctl is-active bitcoin-scanner, /bin/systemctl is-active bitcoin-scanner.service, /bin/systemctl status bitcoin-scanner, /bin/systemctl status bitcoin-scanner.service, /bin/systemctl restart bitcoin-scanner-frontend, /bin/systemctl restart bitcoin-scanner-frontend.service, /bin/systemctl is-active bitcoin-scanner-frontend, /bin/systemctl is-active bitcoin-scanner-frontend.service, /bin/systemctl status bitcoin-scanner-frontend, /bin/systemctl status bitcoin-scanner-frontend.service, /bin/systemctl daemon-reload, /bin/systemctl reload nginx, /usr/sbin/nginx -t
