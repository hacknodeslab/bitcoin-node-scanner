[Unit]
Description=Bitcoin Node Scanner — FastAPI backend
Documentation=https://github.com/hacknodeslab/bitcoin-node-scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bitcoin-node-scanner
# WEB_API_KEY, DATABASE_URL, FRONTEND_ORIGIN, SHODAN_API_KEY, ... come from the
# repo's .env (see env.example). WEB_HOST/WEB_PORT default to 127.0.0.1:8000,
# which is what scripts/nginx/bitcoin-scanner.conf proxies to.
EnvironmentFile=/home/ubuntu/bitcoin-node-scanner/.env
ExecStart=/home/ubuntu/bitcoin-node-scanner/venv/bin/python -m src.web.main
Restart=on-failure
RestartSec=5
# Background scans (pandas/matplotlib) run inside this process.
MemoryMax=2G

# Hardening. The repo dir stays writable: SQLite DB, output/, .cdn_cache,
# geoip_dbs/ and the NVD cache all live there.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bitcoin-node-scanner

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
